<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Savyn" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorError">@color/md_theme_light_error</item>

        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>

        <!-- Bold Headers and Card Styles -->
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Savyn.BoldTitleMedium</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Savyn.BoldHeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Savyn.BoldHeadlineSmall</item>
        <item name="materialCardViewStyle">@style/Widget.Savyn.CardView</item>
        <item name="textInputStyle">@style/Widget.Savyn.TextInputLayout</item>

        <!-- Bold Toolbar Text -->
        <item name="toolbarStyle">@style/Widget.Savyn.Toolbar</item>

        <!-- Branded Button Styles -->
        <item name="materialButtonStyle">@style/Widget.Savyn.Button</item>
    </style>

    <style name="Widget.Savyn.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.Savyn.ToolbarTitle</item>
    </style>

    <style name="TextAppearance.Savyn.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="ShapeAppearance.Savyn.Input" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.Savyn.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.Savyn.Input</item>
    </style>

    <style name="TextAppearance.Savyn.BoldTitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Savyn.BoldHeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Savyn.BoldHeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Savyn.BoldHeadlineMedium.OnPrimary" parent="TextAppearance.Savyn.BoldHeadlineMedium">
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="TextAppearance.Savyn.LabelMedium.OnPrimary" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:alpha">0.8</item>
    </style>

    <style name="ShapeAppearance.Savyn.SummaryCard" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">24dp</item>
        <item name="cornerSizeBottomRight">24dp</item>
    </style>

    <style name="Widget.Savyn.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
    </style>

    <style name="Widget.Savyn.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.Savyn.Button.Rounded" parent="Widget.Material3.Button">
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="Widget.Savyn.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="Theme.Savyn" parent="Base.Theme.Savyn">
        <item name="floatingActionButtonStyle">@style/Widget.Savyn.FAB</item>
        <item name="bottomSheetDialogTheme">@style/Theme.Savyn.BottomSheet</item>
    </style>

    <style name="Widget.Savyn.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundColor">?attr/colorPrimary</item>
        <item name="tint">?attr/colorOnPrimary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Savyn.FAB</item>
    </style>

    <style name="ShapeAppearance.Savyn.FAB" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Savyn.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.Savyn.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Savyn.BottomSheet</item>
        <item name="backgroundTint">@color/md_theme_light_background</item>
    </style>

    <style name="Theme.Savyn.BottomSheet" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Savyn.BottomSheet</item>
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="textInputStyle">@style/Widget.Savyn.TextInputLayout</item>
    </style>
</resources>
